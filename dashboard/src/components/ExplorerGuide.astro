---
import { MODEL_CATALOG, PROVIDER_CATALOG } from "../lib/catalog";
import { SOURCE_URL, TOKENIZER_FAQS } from "../lib/site-metadata";

const providerNames = PROVIDER_CATALOG.map((provider) => provider.name);
const modelCount = MODEL_CATALOG.models.length;
---

<div class="explorer-guide">
  <section id="methodology" class="guide-section" aria-labelledby="methodology-title">
    <div class="guide-section__heading">
      <p class="eyebrow">How the comparison works</p>
      <h2 id="methodology-title">Measure tokenization without hiding the tradeoffs</h2>
      <p>
        TokEval compares the exact same text across tokenizer and model families.
        The live ordering puts the smallest displayed token count first, making
        differences easy to inspect without treating token count as a model-quality score.
      </p>
    </div>

    <div class="guide-grid">
      <article>
        <h3>Local, byte-safe tokenization</h3>
        <p>
          Public tokenizer artifacts run in your browser. Where the tokenizer
          exposes lossless boundaries, each colored piece retains its raw bytes
          even when a token splits a UTF-8 character.
        </p>
      </article>
      <article>
        <h3>Exact and estimated API counts</h3>
        <p>
          Provider APIs differ. Exact badges identify exposed tokenizer output;
          estimate badges identify count-only services where raw content is
          approximated separately from request framing.
        </p>
      </article>
      <article>
        <h3>Multilingual comparisons</h3>
        <p>
          Try Korean, English, Turkish, mixed scripts, emoji, code, or your own
          domain text. Vocabulary coverage and normalization can make the same
          meaning occupy very different numbers of tokens.
        </p>
      </article>
    </div>
  </section>

  <section id="supported-models" class="guide-section" aria-labelledby="models-title">
    <div class="guide-section__heading">
      <p class="eyebrow">Model catalog</p>
      <h2 id="models-title">Compare {modelCount} model entries across leading providers</h2>
      <p>
        The catalog maps model releases to distinct tokenizer implementations so
        related models can share verified tokenizer work instead of duplicating it.
        Add any available entry from the model picker above.
      </p>
    </div>
    <ul class="provider-list" aria-label="Supported model providers">
      {providerNames.map((provider) => <li>{provider}</li>)}
    </ul>
  </section>

  <section id="faq" class="guide-section" aria-labelledby="faq-title">
    <div class="guide-section__heading">
      <p class="eyebrow">Common questions</p>
      <h2 id="faq-title">AI token counting and tokenizer efficiency FAQ</h2>
    </div>
    <div class="faq-list">
      {TOKENIZER_FAQS.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
    <p class="guide-source">
      TokEval is open source. Review the pinned model catalog, methodology, and
      implementation on <a href={SOURCE_URL}>GitHub</a>.
    </p>
  </section>
</div>
