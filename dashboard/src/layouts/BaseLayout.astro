---
import "../styles/global.css";
import {
  SITE_NAME,
  SITE_URL,
  SOURCE_URL,
  type FaqItem,
} from "../lib/site-metadata";

interface Props {
  title: string;
  description: string;
  faqItems?: readonly FaqItem[];
  indexable?: boolean;
}

const {
  title,
  description,
  faqItems = [],
  indexable = true,
} = Astro.props;
const socialTitle = `${title} — ${SITE_NAME}`;
const siteUrl = Astro.site ?? SITE_URL;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const rootUrl = new URL("/", siteUrl).href;
const organizationId = `${rootUrl}#organization`;
const websiteId = `${rootUrl}#website`;
const applicationId = `${rootUrl}#application`;
const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": organizationId,
    name: SITE_NAME,
    url: rootUrl,
    sameAs: [SOURCE_URL],
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    url: rootUrl,
    name: SITE_NAME,
    alternateName: "TokEval Explorer",
    description,
    inLanguage: "en",
    publisher: { "@id": organizationId },
  },
  {
    "@type": "WebApplication",
    "@id": applicationId,
    name: "TokEval Explorer",
    alternateName: "TokEval AI Tokenizer Comparison",
    url: canonicalUrl,
    description,
    applicationCategory: "DeveloperApplication",
    applicationSubCategory: "AI tokenizer comparison tool",
    operatingSystem: "Any",
    browserRequirements: "JavaScript enabled for interactive comparisons",
    isAccessibleForFree: true,
    inLanguage: "en",
    featureList: [
      "Compare token counts across AI model families",
      "Inspect local tokenizer pieces, IDs, and byte boundaries",
      "Compare multilingual tokenization efficiency",
      "Distinguish exact provider counts from estimates",
    ],
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    author: { "@id": organizationId },
    isPartOf: { "@id": websiteId },
  },
];

if (faqItems.length > 0) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${canonicalUrl}#faq-schema`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  });
}

const structuredData = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f0e8" />
    <script is:inline>
      (() => {
        let savedTheme = null;
        try {
          savedTheme = localStorage.getItem("tokeval-theme");
        } catch {
          // Use the system preference when storage is unavailable.
        }

        const theme =
          savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", theme === "dark" ? "#181815" : "#fffcf0");
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? "index, follow" : "noindex, follow"} />
    {indexable && <link rel="canonical" href={canonicalUrl} />}
    <link rel="home" href={rootUrl} />
    <link rel="sitemap" href="/sitemap.xml" type="application/xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{socialTitle}</title>
    {indexable && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <slot />
  </body>
</html>

