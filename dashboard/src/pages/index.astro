---
import { TokenComparer } from "../components/TokenComparer";
import GitHubLink from "../components/GitHubLink.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { INITIAL_HOSTED_RESULTS } from "../lib/initial-hosted-results";
import { INITIAL_RESULTS, INITIAL_TEXT } from "../lib/initial-tokenization";
import { loadHostedModelProfiles } from "../lib/hosted-tokenizer";

const description =
  "Compare multilingual token counts and available breakdowns across leading hosted and open-weight model providers.";
const currentYear = new Date().getFullYear();
const hostedProfiles = await loadHostedModelProfiles();
---

<BaseLayout title="Multilingual Token Explorer" description={description}>
  <div class="page-shell">
    <header class="site-header">
      <a class="wordmark" href="/">TokEval</a>
      <nav class="site-header__actions" aria-label="Site links">
        <GitHubLink />
        <ThemeToggle />
      </nav>
    </header>

    <main>
      <section class="intro" aria-labelledby="page-title">
        <h1 id="page-title">Tokenizer</h1>
        <p>
          See how model families from different providers break text into
          tokens. Token IDs appear beneath each piece. Angle brackets indicate
          a token containing only part of a UTF-8 character; exact bytes are
          shown instead of invented text. Open-model vocabulary files are
          downloaded from their pinned public repositories, cached by the
          browser, and run in a local worker. Local rows do not send input to a
          model API. Anthropic, Google, and xAI rows update automatically and
          send the entered text to those providers through the TokEval server.
          Plain-text local results come from pinned public tokenizer artifacts
          using <a
            href="https://www.npmjs.com/package/js-tiktoken/v/1.0.21"
            target="_blank"
            rel="noreferrer"
          ><code>js-tiktoken@1.0.21</code></a>,
          <code>@huggingface/tokenizers@0.2.0</code>, and
          <code>@sctg/sentencepiece-js@1.3.3</code>. These are local tokenizer
          outputs, not hosted inference or API token counts.
        </p>
      </section>

      <TokenComparer
        client:load
        initialText={INITIAL_TEXT}
        initialResults={INITIAL_RESULTS}
        initialHostedResults={INITIAL_HOSTED_RESULTS}
        hostedProfiles={hostedProfiles}
      />
    </main>

    <footer class="site-footer">© TokEval {currentYear}</footer>
  </div>
</BaseLayout>

