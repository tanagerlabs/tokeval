---
import ExplorerGuide from "../components/ExplorerGuide.astro";
import { TokenComparer } from "../components/TokenComparer";
import GitHubLink from "../components/GitHubLink.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { INITIAL_HOSTED_RESULTS } from "../lib/initial-hosted-results";
import { INITIAL_RESULTS, INITIAL_TEXT } from "../lib/initial-tokenization";
import { loadHostedModelProfiles } from "../lib/hosted-tokenizer";
import {
  HOME_DESCRIPTION,
  HOME_TITLE,
  SOURCE_URL,
  TOKENIZER_FAQS,
} from "../lib/site-metadata";

const currentYear = new Date().getFullYear();
const hostedProfiles = await loadHostedModelProfiles();
---

<BaseLayout
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
  faqItems={TOKENIZER_FAQS}
>
  <div class="page-shell">
    <a class="skip-link" href="#main-content">Skip to token comparison</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="TokEval home">TokEval</a>
      <nav class="site-header__actions" aria-label="Site links">
        <a class="site-header__link" href="#methodology">How it works</a>
        <a class="site-header__link" href="#supported-models">Models</a>
        <GitHubLink />
        <ThemeToggle />
      </nav>
    </header>

    <main id="main-content">
      <section class="intro" aria-labelledby="page-title">
        <p class="eyebrow">Free multilingual token comparison</p>
        <h1 id="page-title">Compare AI tokenizer efficiency</h1>
        <p>
          Enter the same text once to compare token counts across leading AI
          model families. Inspect exact token pieces where they are available,
          see which tokenizer represents your text most compactly, and explore
          how Korean, English, mixed scripts, emoji, or code change the result.
        </p>
        <p class="intro__note">
          Fewer tokens can preserve context space and may reduce token-based
          input charges. It does not, by itself, establish model quality or
          total serving cost.
        </p>
      </section>

      <section class="tool-section" aria-labelledby="comparison-title">
        <div class="tool-section__heading">
          <h2 id="comparison-title">Compare model token counts</h2>
          <p>
            Results update as you type and rank the visible models from the
            fewest displayed tokens to the most.
          </p>
        </div>
        <TokenComparer
          client:load
          initialText={INITIAL_TEXT}
          initialResults={INITIAL_RESULTS}
          initialHostedResults={INITIAL_HOSTED_RESULTS}
          hostedProfiles={hostedProfiles}
        />
      </section>

      <ExplorerGuide />
    </main>

    <footer class="site-footer">
      <span>© TokEval {currentYear}</span>
      <nav aria-label="Footer links">
        <a href="#methodology">Methodology</a>
        <a href="#faq">FAQ</a>
        <a href={SOURCE_URL}>Source</a>
      </nav>
    </footer>
  </div>
</BaseLayout>

