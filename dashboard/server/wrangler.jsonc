{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tokeval-tokenizer-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "limits": {
    "cpu_ms": 100,
    "subrequests": 16
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:4321,http://127.0.0.1:4321,http://[::1]:4321",
    "ANTHROPIC_MODEL": "claude-opus-5-5",
    "GEMINI_MODEL": "gemini-4-argon",
    "XAI_MODEL": "grok-4.7",
    "ENABLE_XAI": "true",
    "LOG_PROVIDER_IO": "true",
    "ADDITIONAL_MODELS_JSON": "[]",
    "COUNT_CACHE_TTL_SECONDS": "300",
    "UPSTREAM_TIMEOUT_MS": "2500"
  },
  "ratelimits": [
    {
      "name": "REQUEST_RATE_LIMITER",
      "namespace_id": "17001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "XAI_RATE_LIMITER",
      "namespace_id": "17002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
